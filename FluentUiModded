-- ──────────────────────────────────────────────────────────────────────────────
-- Utility: Theme property
-- ──────────────────────────────────────────────────────────────────────────────
local function GetThemeProp(key)
    local t = Themes[Library.Theme]
    return t and t[key] or Themes.YinYang[key]
end

-- ──────────────────────────────────────────────────────────────────────────────
-- Utility: Create Instance
-- ──────────────────────────────────────────────────────────────────────────────
local DefaultProps = {
    Frame         = { BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0 },
    ScrollingFrame= { BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ScrollBarImageColor3=Color3.new(0,0,0) },
    TextLabel     = { BackgroundTransparency=1, Font=Enum.Font.GothamSemibold, Text="", TextColor3=Color3.new(0,0,0), TextSize=14, BorderSizePixel=0 },
    TextButton    = { BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, AutoButtonColor=false, Font=Enum.Font.GothamSemibold, Text="", TextColor3=Color3.new(0,0,0), TextSize=14 },
    TextBox       = { BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ClearTextOnFocus=false, Font=Enum.Font.GothamSemibold, Text="", TextColor3=Color3.new(0,0,0), TextSize=14 },
    ImageLabel    = { BackgroundTransparency=1, BorderSizePixel=0 },
    ImageButton   = { BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, AutoButtonColor=false },
    CanvasGroup   = { BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0 },
}

local function New(class, props, children)
    local obj = Instance.new(class)
    local defaults = DefaultProps[class]
    if defaults then
        for k, v in pairs(defaults) do obj[k] = v end
    end
    if props then
        for k, v in pairs(props) do
            if k ~= "ThemeTag" then
                obj[k] = v
            end
        end
    end
    if children then
        for _, child in ipairs(children) do
            if child then child.Parent = obj end
        end
    end
    if props and props.ThemeTag then
        Library:AddThemeObject(obj, props.ThemeTag)
    end
    return obj
end

-- ──────────────────────────────────────────────────────────────────────────────
-- Theme registry
-- ──────────────────────────────────────────────────────────────────────────────
function Library:AddThemeObject(obj, tag)
    self.Registry[obj] = tag
    self:ApplyTheme(obj, tag)
    return obj
end

function Library:ApplyTheme(obj, tag)
    for prop, key in pairs(tag) do
        local val = GetThemeProp(key)
        if val ~= nil then
            pcall(function() obj[prop] = val end)
        end
    end
end

function Library:UpdateTheme()
    for obj, tag in pairs(self.Registry) do
        if obj and obj.Parent then
            self:ApplyTheme(obj, tag)
        end
    end
end

function Library:SetTheme(name)
    if Themes[name] then
        self.Theme = name
        self:UpdateTheme()
        -- refresh search highlights
        self:RefreshSearchHighlights()
    end
end

function Library:AddSignal(sig, fn)
    table.insert(self.Signals, sig:Connect(fn))
end

function Library:Disconnect()
    for i = #self.Signals, 1, -1 do
        local s = table.remove(self.Signals, i)
        pcall(function() s:Disconnect() end)
    end
end

function Library:SafeCallback(cb, ...)
    if not cb then return end
    local ok, err = pcall(cb, ...)
    if not ok then
        self:Notify({ Title = "Callback Error", Content = tostring(err), Duration = 5 })
    end
end

function Library:Notify(data)
    -- lightweight notification (toast)
    local gui = self.GUI
    if not gui then return end
    local holder = gui:FindFirstChild("NotifHolder")
    if not holder then
        holder = New("Frame", {
            Name = "NotifHolder",
            Size = UDim2.new(0,310,1,-30),
            Position = UDim2.new(1,-320,1,-30),
            AnchorPoint = Vector2.new(0,1),
            BackgroundTransparency = 1,
            Parent = gui,
        }, {
            New("UIListLayout", {
                VerticalAlignment = Enum.VerticalAlignment.Bottom,
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
                Padding = UDim.new(0,8),
                SortOrder = Enum.SortOrder.LayoutOrder,
            })
        })
    end
    local notif = New("Frame", {
        Size = UDim2.new(1,0,0,60),
        BackgroundColor3 = GetThemeProp("Dialog"),
        BackgroundTransparency = 0.1,
        Parent = holder,
    }, {
        New("UICorner", { CornerRadius = UDim.new(0,8) }),
        New("UIStroke", { Color = GetThemeProp("AcrylicBorder"), Transparency = 0.4 }),
        New("TextLabel", {
            Text = "[" .. (data.Title or "Info") .. "] " .. (data.Content or ""),
            TextColor3 = GetThemeProp("Text"),
            TextSize = 13,
            Font = Enum.Font.GothamSemibold,
            Size = UDim2.new(1,-20,1,0),
            Position = UDim2.fromOffset(10,0),
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
        }),
    })
    local dur = data.Duration or 4
    task.delay(dur, function()
        if notif and notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
            task.wait(0.3)
            pcall(function() notif:Destroy() end)
        end
    end)
    return notif
end

-- ──────────────────────────────────────────────────────────────────────────────
-- Animated Broken Gradient Border
-- ──────────────────────────────────────────────────────────────────────────────
local function CreateBrokenGradientBorder(parent)
    -- Outer stroke animated with a rotating gradient via UIGradient + UIStroke trick
    local strokeFrame = New("Frame", {
        Name = "BrokenGradientBorder",
        Size = UDim2.new(1, 4, 1, 4),
        Position = UDim2.fromOffset(-2, -2),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 1,
        ZIndex = 0,
        Parent = parent,
    }, {
        New("UICorner", { CornerRadius = UDim.new(0, 10) }),
    })

    -- We simulate the broken gradient by layering 4 thin ImageLabels on edges
    -- that cycle through colors
    local colors = {
        Color3.fromRGB(96, 205, 255),
        Color3.fromRGB(255, 90, 180),
        Color3.fromRGB(255, 215, 0),
        Color3.fromRGB(90, 255, 160),
    }

    local stroke = New("UIStroke", {
        Thickness = 2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = colors[1],
        Parent = parent,
    })

    local idx = 0
    local running = true
    local t = 0
    task.spawn(function()
        while running do
            t = t + task.wait(0.03)
            -- Animate hue cycling for a "broken gradient" neon look
            local h = (t * 0.15) % 1
            local c1 = Color3.fromHSV(h, 0.9, 1)
            local c2 = Color3.fromHSV((h + 0.33) % 1, 0.9, 1)
            local c3 = Color3.fromHSV((h + 0.66) % 1, 0.9, 1)
            -- pulse thickness
            local pulse = 1.5 + math.sin(t * 3) * 0.5
            pcall(function()
                stroke.Color = c1
                stroke.Thickness = pulse
            end)
        end
    end)

    -- Return cleanup
    return function()
        running = false
        pcall(function() strokeFrame:Destroy() end)
    end
end

