-- Toggle
local function CreateToggle(tab, name, opts)
    opts = opts or {}
    opts.Callback = opts.Callback or function() end
    local obj = { Value = opts.Default or false, Type = "Toggle",
                  Callback = opts.Callback, Changed = nil }
    local el = CreateElement(opts.Title, opts.Description, tab.Container, true)
    el.DescLabel.Size = UDim2.new(1,-54,0,14)

    local slider = New("ImageLabel", {
        AnchorPoint = Vector2.new(0,0.5),
        Size = UDim2.fromOffset(14,14),
        Position = UDim2.new(0,2,0.5,0),
        Image = "rbxassetid://12266946128",
        ImageTransparency = 0.5,
        ThemeTag = { ImageColor3 = "ToggleSlider" },
    })
    local stroke = New("UIStroke", {
        Transparency = 0.5,
        ThemeTag = { Color = "ToggleSlider" },
    })
    local track = New("Frame", {
        Size = UDim2.fromOffset(36,18),
        AnchorPoint = Vector2.new(1,0.5),
        Position = UDim2.new(1,-10,0.5,0),
        BackgroundTransparency = 1,
        Parent = el.Frame,
        ThemeTag = { BackgroundColor3 = "Accent" },
    }, {
        New("UICorner", { CornerRadius = UDim.new(0,9) }),
        stroke, slider,
    })
    Library:AddThemeObject(slider, { ImageColor3 = "ToggleSlider" })
    Library:AddThemeObject(stroke, { Color = "ToggleSlider" })
    Library:AddThemeObject(track,  { BackgroundColor3 = "Accent" })

    local function refresh()
        Library:ApplyTheme(stroke, { Color = obj.Value and "Accent" or "ToggleSlider" })
        Library:ApplyTheme(slider, { ImageColor3 = obj.Value and "ToggleToggled" or "ToggleSlider" })
        TweenService:Create(slider, TweenInfo.new(0.25,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
            { Position = UDim2.new(0, obj.Value and 19 or 2, 0.5, 0) }):Play()
        TweenService:Create(track,  TweenInfo.new(0.25,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
            { BackgroundTransparency = obj.Value and 0 or 1 }):Play()
        slider.ImageTransparency = obj.Value and 0 or 0.5
        Library:SafeCallback(obj.Callback, obj.Value)
        Library:SafeCallback(obj.Changed, obj.Value)
    end

    function obj:SetValue(v)
        self.Value = not not v
        refresh()
    end
    function obj:OnChanged(fn) self.Changed = fn fn(self.Value) end
    function obj:Destroy() el:Destroy() Library.Options[name] = nil end

    Library:AddSignal(el.Frame.MouseButton1Click, function()
        obj:SetValue(not obj.Value)
    end)
    obj:SetValue(obj.Value)
    Library.Options[name] = obj
    return obj
end

