    Library:AddSignal(UserInputService.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement) then
            local pct = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            obj:SetValue(obj.Min + (obj.Max - obj.Min) * pct)
        end
    end)

    local round = opts.Rounding
    function obj:SetValue(v)
        self.Value = tonumber(string.format("%." .. round .. "f",
            math.clamp(v, self.Min, self.Max)))
        local pct = (self.Value - self.Min) / (self.Max - self.Min)
        dot.Position = UDim2.new(pct, -7, 0.5, 0)
        fill.Size = UDim2.fromScale(pct, 1)
        valLabel.Text = tostring(self.Value)
        Library:SafeCallback(self.Callback, self.Value)
        Library:SafeCallback(self.Changed, self.Value)
    end
    function obj:OnChanged(fn) self.Changed = fn fn(self.Value) end
    function obj:Destroy() el:Destroy() Library.Options[name] = nil end

    obj:SetValue(opts.Default or obj.Min)
    Library.Options[name] = obj
    return obj
end

