        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = GetThemeProp("ElementBorder"),
    })
    local titleLabel = New("TextLabel", {
        Font = Enum.Font.GothamSemibold,
        Text = title or "",
        TextColor3 = GetThemeProp("Text"),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1,0,0,14),
        ThemeTag = { TextColor3 = "Text" },
    })
    local descLabel = New("TextLabel", {
        Font = Enum.Font.Gotham,
        Text = desc or "",
        TextColor3 = GetThemeProp("SubText"),
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1,0,0,14),
        Visible = desc ~= nil and desc ~= "",
        ThemeTag = { TextColor3 = "SubText" },
    })
    local labelHolder = New("Frame", {
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10,0),
        Size = UDim2.new(1,-28,0,0),
    }, {
        New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
        New("UIPadding", { PaddingBottom=UDim.new(0,13), PaddingTop=UDim.new(0,13) }),
        titleLabel,
        descLabel,
    })
    local frame = New("TextButton", {
        Size = UDim2.new(1,0,0,0),
        BackgroundTransparency = 0.89,
        BackgroundColor3 = GetThemeProp("Element"),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = "",
        LayoutOrder = 7,
        Parent = container,
        ThemeTag = { BackgroundColor3="Element", BackgroundTransparency="ElementTransparency" },
    }, {
        New("UICorner", { CornerRadius = UDim.new(0,4) }),
        border,
        labelHolder,
    })
    Library:AddThemeObject(titleLabel, { TextColor3 = "Text" })
    Library:AddThemeObject(descLabel,  { TextColor3 = "SubText" })
    Library:AddThemeObject(frame,      { BackgroundColor3 = "Element" })
    Library:AddThemeObject(border,     { Color = "ElementBorder" })

    -- Register for search
    Library:RegisterElement(title, desc, frame, border)

    if interactive then
        Library:AddSignal(frame.MouseEnter, function()
            TweenService:Create(frame, TweenInfo.new(0.15), {
                BackgroundTransparency = GetThemeProp("ElementTransparency") - GetThemeProp("HoverChange")
            }):Play()
        end)
        Library:AddSignal(frame.MouseLeave, function()
            TweenService:Create(frame, TweenInfo.new(0.15), {
                BackgroundTransparency = GetThemeProp("ElementTransparency")
            }):Play()
        end)
    end

    local obj = {}
    obj.Frame = frame
    obj.TitleLabel = titleLabel
    obj.DescLabel  = descLabel
    obj.Border     = border
    function obj:SetTitle(t) titleLabel.Text = t end
    function obj:SetDesc(d)
        descLabel.Text = d or ""
        descLabel.Visible = d ~= nil and d ~= ""
    end
    function obj:Destroy() frame:Destroy() end
    return obj
end

