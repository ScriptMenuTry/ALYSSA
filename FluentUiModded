            BackgroundTransparency = 1,
            ThemeTag = { TextColor3 = "Text" },
            Parent = logoFrame,
        })
        local urole = New("TextLabel", {
            Text = anonymous and "User" or (opts.UserRole or "Member"),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = GetThemeProp("SubText"),
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1,-52,0,12),
            Position = UDim2.fromOffset(48,27),
            BackgroundTransparency = 1,
            ThemeTag = { TextColor3 = "SubText" },
            Parent = logoFrame,
        })
        self:AddThemeObject(uname,  { TextColor3 = "Text" })
