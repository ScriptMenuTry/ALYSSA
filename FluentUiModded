            Position = UDim2.fromOffset(8,54),
            BackgroundColor3 = GetThemeProp("TitleBarLine"),
            BackgroundTransparency = 0.5,
            Parent = sidebar,
        })
    end

    -- ── Search bar in sidebar (if SearchInHeader or by default) ──────────────
    local showSearch = opts.SearchInHeader ~= false  -- default true
    local searchQuery = ""
    local searchBox

    if showSearch then
        local searchFrame = New("Frame", {
            Size = UDim2.new(1,-16,0,28),
            Position = UDim2.fromOffset(8, showProfile and 62 or 8),
            BackgroundColor3 = GetThemeProp("InputFocused"),
            BackgroundTransparency = 0.7,
            Parent = sidebar,
        }, {
            New("UICorner", { CornerRadius = UDim.new(0,6) }),
            New("UIStroke", { Transparency=0.6, ThemeTag={Color="InElementBorder"} }),
            New("ImageLabel", {
                Image = "rbxassetid://10734943674",
                Size = UDim2.fromOffset(14,14),
                Position = UDim2.fromOffset(6,7),
                BackgroundTransparency = 1,
                ThemeTag = { ImageColor3 = "SubText" },
            }),
        })
        searchBox = New("TextBox", {
            PlaceholderText = "Search...",
            Text = "",
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = GetThemeProp("Text"),
            PlaceholderColor3 = GetThemeProp("SubText"),
            BackgroundTransparency = 1,
            Size = UDim2.new(1,-26,1,0),
            Position = UDim2.fromOffset(24,0),
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            Parent = searchFrame,
            ThemeTag = { TextColor3 = "Text", PlaceholderColor3 = "SubText" },
        })
        self:AddThemeObject(searchFrame, { BackgroundColor3 = "InputFocused" })
        self:AddThemeObject(searchBox,   { TextColor3 = "Text", PlaceholderColor3 = "SubText" })

        self:AddSignal(searchBox:GetPropertyChangedSignal("Text"), function()
            Library.SearchQuery = searchBox.Text
            Library:RefreshSearchHighlights()
        end)
    end

    -- Tab holder (scrolling)
    local tabOffsetY = (showProfile and 62 or 8) + (showSearch and 36 or 0) + 4
    local tabHolder = New("ScrollingFrame", {
        Size = UDim2.new(1,0,1,-tabOffsetY),
        Position = UDim2.fromOffset(0, tabOffsetY),
        BackgroundTransparency = 1,
        ScrollBarImageTransparency = 1,
        ScrollBarThickness = 0,
        BorderSizePixel = 0,
        CanvasSize = UDim2.fromScale(0,0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = sidebar,
    }, {
        New("UIListLayout", { Padding = UDim.new(0,4) }),
        New("UIPadding", { PaddingLeft=UDim.new(0,6), PaddingRight=UDim.new(0,6), PaddingTop=UDim.new(0,4), PaddingBottom=UDim.new(0,4) }),
    })
    self:AddSignal(tabHolder.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        tabHolder.CanvasSize = UDim2.new(0,0,0,tabHolder.UIListLayout.AbsoluteContentSize.Y)
    end)

    -- Accent selector bar
    local selectorBar = New("Frame", {
        Size = UDim2.fromOffset(4,0),
        BackgroundColor3 = GetThemeProp("Accent"),
        Position = UDim2.fromOffset(0, tabOffsetY + 17),
        AnchorPoint = Vector2.new(0,0.5),
        Parent = sidebar,
    }, { New("UICorner", { CornerRadius = UDim.new(0,2) }) })
    self:AddThemeObject(selectorBar, { BackgroundColor3 = "Accent" })

    -- ── Content area ─────────────────────────────────────────────────────────
    local tabDisplay = New("TextLabel", {
        RichText = true,
        Text = "Tab",
        Font = Enum.Font.GothamBold,
        TextSize = 24,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1,-16,0,28),
        Position = UDim2.fromOffset(tabWidth + 20, 10),
        BackgroundTransparency = 1,
        ThemeTag = { TextColor3 = "Text" },
        Parent = root,
    })
    self:AddThemeObject(tabDisplay, { TextColor3 = "Text" })

    -- Separator
    New("Frame", {
        Size = UDim2.new(1 - (tabWidth+16)/winSize.X.Offset, 0, 0, 1),
        Position = UDim2.fromOffset(tabWidth + 20, 44),
        BackgroundTransparency = 0.5,
        ThemeTag = { BackgroundColor3 = "TitleBarLine" },
        Parent = root,
    })

    local containerHolder = New("CanvasGroup", {
        Size = UDim2.new(1, -tabWidth-32, 1, -60),
        Position = UDim2.fromOffset(tabWidth + 20, 52),
        BackgroundTransparency = 1,
        Parent = root,
    })

    -- ── Title bar (top of root for dragging) ─────────────────────────────────
    local titleBar = New("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        Parent = root,
    }, {
        New("TextLabel", {
            Text = opts.Title,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextColor3 = GetThemeProp("Text"),
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(0, tabWidth-10, 1, 0),
            Position = UDim2.fromOffset(10, 0),
            BackgroundTransparency = 1,
            ThemeTag = { TextColor3 = "Text" },
        }),
    })
    local titleLabel = titleBar:FindFirstChildWhichIsA("TextLabel")
    if titleLabel then self:AddThemeObject(titleLabel, { TextColor3 = "Text" }) end

    -- Window control buttons
    local function WinBtn(icon, pos, cb)
        local btn = New("TextButton", {
            Size = UDim2.fromOffset(28,28),
            AnchorPoint = Vector2.new(1,0.5),
            Position = pos,
            BackgroundTransparency = 1,
            Text = "",
            Parent = titleBar,
        }, {
            New("ImageLabel", {
                Image = icon,
                Size = UDim2.fromOffset(14,14),
                Position = UDim2.fromScale(0.5,0.5),
                AnchorPoint = Vector2.new(0.5,0.5),
                BackgroundTransparency = 1,
                ThemeTag = { ImageColor3 = "Text" },
            }),
        })
        self:AddSignal(btn.MouseButton1Click, cb)
        return btn
    end

    -- Close
    WinBtn("rbxassetid://9886659671", UDim2.new(1,-4,0.5,0), function()
        self:Destroy()
    end)
    -- Minimize
    WinBtn("rbxassetid://9886659276", UDim2.new(1,-38,0.5,0), function()
        root.Visible = not root.Visible
    end)

    -- ── Dragging ─────────────────────────────────────────────────────────────
    local dragging, dragStart, startPos = false, nil, nil
    self:AddSignal(titleBar.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = i.Position
            startPos  = root.Position
        end
    end)
    self:AddSignal(UserInputService.InputChanged, function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - dragStart
            root.Position = UDim2.fromOffset(
                startPos.X.Offset + delta.X,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    self:AddSignal(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- ── Tab management ────────────────────────────────────────────────────────
    local tabs = {}
    local tabCount = 0
    local selectedTab = 0

    local function GetTabPos(idx)
        if not tabs[idx] then return 0 end
        return tabs[idx].Frame.AbsolutePosition.Y - tabHolder.AbsolutePosition.Y
    end

    local function SelectTab(idx)
        selectedTab = idx
        for i, t in ipairs(tabs) do
            t.Selected = (i == idx)
            TweenService:Create(t.Frame, TweenInfo.new(0.15), {
                BackgroundTransparency = (i == idx) and 0.89 or 1
            }):Play()
            t.Container.Visible = (i == idx)
        end
        tabDisplay.Text = tabs[idx] and tabs[idx].Name or ""
        TweenService:Create(selectorBar, TweenInfo.new(0.2,Enum.EasingStyle.Quart), {
            Position = UDim2.fromOffset(2, tabOffsetY + GetTabPos(idx) + 17)
        }):Play()
    end

    local win = {}
    win.Root            = root
    win.ContainerHolder = containerHolder
    win.TabHolder       = tabHolder
    win.TabDisplay      = tabDisplay
    win.Minimized       = false
    win.GUI             = gui

    function win:AddTab(tabOpts)
        tabCount = tabCount + 1
        local idx = tabCount
        local t = {}
        t.Name     = tabOpts.Title or ("Tab " .. idx)
        t.Selected = false

        local icon = tabOpts.Icon
        t.Frame = New("TextButton", {
            Size = UDim2.new(1,0,0,32),
            BackgroundTransparency = 1,
            Parent = tabHolder,
            ThemeTag = { BackgroundColor3 = "Tab" },
        }, {
            New("UICorner", { CornerRadius = UDim.new(0,6) }),
            New("TextLabel", {
                AnchorPoint = Vector2.new(0,0.5),
                Position = icon and UDim2.new(0,30,0.5,0) or UDim2.new(0,10,0.5,0),
                Text = t.Name,
                RichText = true,
                TextColor3 = GetThemeProp("Text"),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2.new(1,-12,1,0),
                BackgroundTransparency = 1,
                ThemeTag = { TextColor3 = "Text" },
            }),
        })
        Library:AddThemeObject(t.Frame, { BackgroundColor3 = "Tab" })
        local txtLbl = t.Frame:FindFirstChildWhichIsA("TextLabel")
        if txtLbl then Library:AddThemeObject(txtLbl, { TextColor3 = "Text" }) end

        if icon then
            local icoLbl = New("ImageLabel", {
                AnchorPoint = Vector2.new(0,0.5),
                Size = UDim2.fromOffset(16,16),
                Position = UDim2.new(0,8,0.5,0),
                BackgroundTransparency = 1,
                Image = icon,
                Parent = t.Frame,
                ThemeTag = { ImageColor3 = "Text" },
            })
            Library:AddThemeObject(icoLbl, { ImageColor3 = "Text" })
        end

        local layout = New("UIListLayout", { Padding=UDim.new(0,5), SortOrder=Enum.SortOrder.LayoutOrder })
        t.Container = New("ScrollingFrame", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            Parent = containerHolder,
            Visible = false,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Color3.fromRGB(255,255,255),
            ScrollBarImageTransparency = 0.95,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromScale(0,0),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            BottomImage = "rbxassetid://6889812791",
            MidImage    = "rbxassetid://6889812721",
            TopImage    = "rbxassetid://6276641225",
        }, {
            layout,
            New("UIPadding", { PaddingRight=UDim.new(0,10), PaddingLeft=UDim.new(0,1), PaddingTop=UDim.new(0,1), PaddingBottom=UDim.new(0,1) }),
        })
        Library:AddSignal(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
            t.Container.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+2)
        end)
        t.ScrollFrame = t.Container

        Library:AddSignal(t.Frame.MouseButton1Click, function()
            SelectTab(idx)
        end)

        tabs[idx] = t

        -- Auto-select first tab
        if idx == 1 then
            task.defer(function() SelectTab(1) end)
        end

        -- Return a tab object with section/element adders
        local tabObj = setmetatable(t, { __index = TabMeta })
        return tabObj
    end

    function win:Dialog(dialogOpts)
        local tint = New("TextButton", {
            Text = "",
            Size = UDim2.fromScale(1,1),
            BackgroundColor3 = Color3.new(0,0,0),
            BackgroundTransparency = 0.6,
            Parent = root,
        }, { New("UICorner", { CornerRadius = UDim.new(0,8) }) })
        local dlgRoot = New("CanvasGroup", {
            Size = UDim2.fromOffset(320,180),
            AnchorPoint = Vector2.new(0.5,0.5),
            Position = UDim2.fromScale(0.5,0.5),
            GroupTransparency = 0,
            Parent = tint,
            ThemeTag = { BackgroundColor3 = "Dialog" },
        }, {
            New("UICorner", { CornerRadius = UDim.new(0,8) }),
            New("UIStroke", { Transparency=0.5, ThemeTag={Color="DialogBorder"} }),
            New("TextLabel", {
                Text = dialogOpts.Title or "Dialog",
                Font = Enum.Font.GothamBold,
                TextSize = 16,
                TextColor3 = GetThemeProp("Text"),
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2.new(1,0,0,22),
                Position = UDim2.fromOffset(16,16),
                BackgroundTransparency = 1,
                ThemeTag = { TextColor3 = "Text" },
            }),
            New("TextLabel", {
                Text = dialogOpts.Content or "",
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextColor3 = GetThemeProp("SubText"),
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                Size = UDim2.new(1,-32,0,80),
                Position = UDim2.fromOffset(16,44),
                BackgroundTransparency = 1,
                ThemeTag = { TextColor3 = "SubText" },
            }),
        })
        Library:AddThemeObject(dlgRoot, { BackgroundColor3 = "Dialog" })

        local btnHolder = New("Frame", {
            Size = UDim2.new(1,0,0,44),
            Position = UDim2.new(0,0,1,-44),
            BackgroundTransparency = 0.5,
            Parent = dlgRoot,
            ThemeTag = { BackgroundColor3 = "DialogHolder" },
        }, {
            New("UIListLayout", { FillDirection=Enum.FillDirection.Horizontal, HorizontalAlignment=Enum.HorizontalAlignment.Center, Padding=UDim.new(0,8), VerticalAlignment=Enum.VerticalAlignment.Center }),
        })
        Library:AddThemeObject(btnHolder, { BackgroundColor3 = "DialogHolder" })

        local btns = dialogOpts.Buttons or {}
        for _, b in ipairs(btns) do
            local bb = New("TextButton", {
                Size = UDim2.new(1/#btns,-12,0,28),
                Text = b.Title or "OK",
                Font = Enum.Font.GothamSemibold,
                TextSize = 13,
                TextColor3 = GetThemeProp("Text"),
                BackgroundTransparency = 0.9,
                Parent = btnHolder,
                ThemeTag = { BackgroundColor3 = "DialogButton", TextColor3 = "Text" },
            }, {
                New("UICorner", { CornerRadius = UDim.new(0,4) }),
                New("UIStroke", { Transparency=0.65, ThemeTag={Color="DialogButtonBorder"} }),
            })
            Library:AddThemeObject(bb, { BackgroundColor3="DialogButton", TextColor3="Text" })
            Library:AddSignal(bb.MouseButton1Click, function()
                Library:SafeCallback(b.Callback)
                pcall(function() tint:Destroy() end)
            end)
        end
        if #btns == 0 then
            Library:AddSignal(tint.MouseButton1Click, function() tint:Destroy() end)
        end
    end

    function win:Destroy()
        Library.Unloaded = true
        cleanupBorder()
        Library:Disconnect()
        pcall(function() gui:Destroy() end)
    end

    function win:SetTheme(name)
        Library:SetTheme(name)
    end

    self.Window = win
    return win
end

-- ──────────────────────────────────────────────────────────────────────────────
