    local anonymous   = opts.Anonymous or false

    if showProfile then
        local avatar = New("ImageLabel", {
            Size = UDim2.fromOffset(32,32),
            Position = UDim2.fromOffset(10, 10),
            Image = anonymous and "rbxassetid://7733960981"
                        or ("https://www.roblox.com/headshot-thumbnail/image?userId="
                            .. LocalPlayer.UserId .. "&width=420&height=420&format=png"),
            BackgroundColor3 = GetThemeProp("AcrylicBorder"),
