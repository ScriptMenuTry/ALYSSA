function Library:CreateWindow(opts)
    assert(opts.Title, "CreateWindow: Missing Title")

    -- Create ScreenGui
    local gui = New("ScreenGui", {
        Name = "FluentUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = RunService:IsStudio() and LocalPlayer.PlayerGui or CoreGui,
    })
    self.GUI = gui

    -- Protect gui
    pcall(function()
        if syn then syn.protect_gui(gui)
        elseif protectgui then protectgui(gui)
        end
    end)

    -- Determine size
    local winSize = opts.Size or UDim2.fromOffset(680, 480)
    local tabWidth = opts.TabWidth or 150

    -- Root frame (draggable)
    local vp = Camera.ViewportSize
    local rootPos = UDim2.fromOffset(vp.X/2 - winSize.X.Offset/2, vp.Y/2 - winSize.Y.Offset/2)

    local root = New("Frame", {
        Name = "WindowRoot",
        Size = winSize,
        Position = rootPos,
        BackgroundTransparency = 1,
        Parent = gui,
    })

    -- Background image
    ApplyBackgroundImage(root)

    -- Main background
    local bg = New("Frame", {
        Name = "Background",
        Size = UDim2.fromScale(1,1),
        BackgroundColor3 = GetThemeProp("AcrylicMain"),
        BackgroundTransparency = 0.08,
        Parent = root,
