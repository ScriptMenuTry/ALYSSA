-- ──────────────────────────────────────────────────────────────────────────────
-- Search highlight helper
-- ──────────────────────────────────────────────────────────────────────────────
function Library:RefreshSearchHighlights()
    local query = self.SearchQuery:lower()
    for _, entry in ipairs(self.AllElements) do
        local match = query ~= "" and (
            entry.title:lower():find(query, 1, true) or
            (entry.desc and entry.desc:lower():find(query, 1, true))
        )
        if entry.frame and entry.frame.Parent then
            -- Show/hide based on match
            entry.frame.Visible = (query == "" or match)
            -- Highlight stroke
            if entry.stroke then
                if match and query ~= "" then
                    entry.stroke.Color = GetThemeProp("SearchHighlight")
                    entry.stroke.Transparency = 0
                    entry.stroke.Thickness = 1.5
                else
                    entry.stroke.Color = GetThemeProp("ElementBorder")
                    entry.stroke.Transparency = 0.5
                    entry.stroke.Thickness = 1
                end
            end
        end
    end
end

function Library:RegisterElement(title, desc, frame, stroke)
    table.insert(self.AllElements, {
        title  = title or "",
        desc   = desc or "",
        frame  = frame,
        stroke = stroke,
    })
end

