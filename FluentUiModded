    local listScroll = New("ScrollingFrame", {
        Size = UDim2.new(1,-5,1,-10),
        Position = UDim2.fromOffset(5,5),
        BackgroundTransparency = 1,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Color3.fromRGB(255,255,255),
        ScrollBarImageTransparency = 0.95,
        BorderSizePixel = 0,
        CanvasSize = UDim2.fromScale(0,0),
    }, { listLayout })
    local dropFrame = New("Frame", {
        Size = UDim2.fromScale(1,0.6),
        ThemeTag = { BackgroundColor3 = "DropdownHolder" },
    }, {
        listScroll,
        New("UICorner", { CornerRadius = UDim.new(0,7) }),
        New("UIStroke", { ApplyStrokeMode=Enum.ApplyStrokeMode.Border, ThemeTag={Color="DropdownBorder"} }),
    })
    local dropHolder = New("Frame", {
        Size = UDim2.fromOffset(170,300),
        BackgroundTransparency = 1,
        Parent = Library.GUI,
        Visible = false,
    }, {
        dropFrame,
        New("UISizeConstraint", { MinSize = Vector2.new(170,0) }),
    })
    Library:AddThemeObject(dropFrame, { BackgroundColor3 = "DropdownHolder" })
    table.insert(Library.OpenFrames, dropHolder)

    local function updatePos()
        local vp = Camera.ViewportSize
        local ap = toggleBtn.AbsolutePosition
        local offset = 0
        if vp.Y - ap.Y < dropHolder.AbsoluteSize.Y - 5 then
            offset = dropHolder.AbsoluteSize.Y - 5 - (vp.Y - ap.Y) + 40
        end
        dropHolder.Position = UDim2.fromOffset(ap.X - 1, ap.Y - 5 - offset)
    end
    Library:AddSignal(toggleBtn:GetPropertyChangedSignal("AbsolutePosition"), updatePos)

    local function updateDisplay()
        if opts.Multi then
            local parts = {}
            for k, v in pairs(obj.Value) do if v then table.insert(parts, k) end end
            dispLabel.Text = #parts > 0 and table.concat(parts, ", ") or "--"
        else
            dispLabel.Text = obj.Value or "--"
        end
    end

    local function buildList()
        for _, c in ipairs(listScroll:GetChildren()) do
            if not c:IsA("UIListLayout") then c:Destroy() end
        end
        for _, item in ipairs(obj.Values) do
            local selected = opts.Multi and obj.Value[item] or obj.Value == item
            local accentBar = New("Frame", {
                Size = UDim2.fromOffset(4,selected and 14 or 6),
                BackgroundColor3 = GetThemeProp("Accent"),
                Position = UDim2.fromOffset(-1,16),
                AnchorPoint = Vector2.new(0,0.5),
            }, { New("UICorner", { CornerRadius=UDim.new(0,2) }) })
            local lbl = New("TextLabel", {
                Font = Enum.Font.Gotham,
                Text = item,
                TextColor3 = GetThemeProp("Text"),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1,1),
                Position = UDim2.fromOffset(10,0),
                ThemeTag = { TextColor3 = "Text" },
            })
            local row = New("TextButton", {
                Size = UDim2.new(1,-5,0,32),
                BackgroundTransparency = selected and 0.89 or 1,
                Text = "",
                Parent = listScroll,
                ZIndex = 23,
                ThemeTag = { BackgroundColor3 = "DropdownOption" },
            }, { accentBar, lbl, New("UICorner", { CornerRadius=UDim.new(0,6) }) })
            Library:AddThemeObject(row,      { BackgroundColor3 = "DropdownOption" })
            Library:AddThemeObject(accentBar,{ BackgroundColor3 = "Accent" })
            Library:AddThemeObject(lbl,      { TextColor3 = "Text" })

            Library:AddSignal(lbl.InputBegan, function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    if opts.Multi then
                        obj.Value[item] = not obj.Value[item] or nil
                    else
                        if obj.Value == item and not opts.AllowNull then return end
                        obj.Value = (obj.Value == item) and nil or item
                    end
                    buildList()
                    updateDisplay()
                    Library:SafeCallback(obj.Callback, obj.Value)
                    Library:SafeCallback(obj.Changed, obj.Value)
                end
            end)
        end
        listScroll.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y)
        local h = #obj.Values > 10 and 392 or listLayout.AbsoluteContentSize.Y + 10
        dropFrame.Size = UDim2.fromOffset(170, h)
    end

    function obj:Open()
        self.Opened = true
        tab.ScrollFrame.ScrollingEnabled = false
        dropHolder.Visible = true
        TweenService:Create(dropFrame, TweenInfo.new(0.2,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
            { Size = UDim2.fromScale(1,1) }):Play()
    end
    function obj:Close()
        self.Opened = false
        tab.ScrollFrame.ScrollingEnabled = true
        dropFrame.Size = UDim2.fromScale(1,0.6)
        dropHolder.Visible = false
    end
    function obj:SetValues(_, vals) if vals then self.Values = vals end buildList() end
    function obj:SetValue(_, v)
        if self.Multi then
            local d = {}
            for _, k in ipairs(v) do if table.find(self.Values, k) then d[k]=true end end
            self.Value = d
        else
            self.Value = table.find(self.Values, v) and v or nil
        end
        buildList() updateDisplay()
        Library:SafeCallback(self.Callback, self.Value)
        Library:SafeCallback(self.Changed, self.Value)
    end
    function obj:OnChanged(fn) self.Changed = fn fn(self.Value) end
    function obj:Destroy() el:Destroy() Library.Options[name] = nil end

    Library:AddSignal(toggleBtn.MouseButton1Click, function() updatePos() obj:Open() end)
    Library:AddSignal(UserInputService.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            local ap, as = dropFrame.AbsolutePosition, dropFrame.AbsoluteSize
            if Mouse.X < ap.X or Mouse.X > ap.X+as.X or Mouse.Y < ap.Y-21 or Mouse.Y > ap.Y+as.Y then
                obj:Close()
            end
        end
    end)

    buildList()
    updateDisplay()
    Library.Options[name] = obj
    return obj
end

