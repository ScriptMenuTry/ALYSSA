local function CreateKeybind(tab, name, opts)
    opts = opts or {}
    local obj = {
        Value    = opts.Default or "None",
        Mode     = opts.Mode or "Toggle",
        Toggled  = false,
        Type     = "Keybind",
        Callback = opts.Callback or function() end,
        ChangedCallback = opts.ChangedCallback or function() end,
        Changed  = nil,
        Clicked  = nil,
    }
    local el = CreateElement(opts.Title, opts.Description, tab.Container, true)
    local kLabel = New("TextLabel", {
        Font = Enum.Font.Gotham,
        Text = obj.Value,
        TextColor3 = GetThemeProp("Text"),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.new(0,0,0,14),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ThemeTag = { TextColor3 = "Text" },
    })
    local kBtn = New("TextButton", {
        Size = UDim2.fromOffset(0,30),
        Position = UDim2.new(1,-10,0.5,0),
        AnchorPoint = Vector2.new(1,0.5),
        BackgroundTransparency = 0.9,
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = el.Frame,
        ThemeTag = { BackgroundColor3 = "Keybind" },
    }, {
        New("UICorner", { CornerRadius = UDim.new(0,5) }),
        New("UIPadding", { PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8) }),
        New("UIStroke", { Transparency=0.5, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, ThemeTag={Color="InElementBorder"} }),
        kLabel,
    })
    Library:AddThemeObject(kBtn,    { BackgroundColor3 = "Keybind" })
    Library:AddThemeObject(kLabel,  { TextColor3 = "Text" })

    local listening = false
    Library:AddSignal(kBtn.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            listening = true
            kLabel.Text = "..."
            task.wait(0.2)
            local conn
            conn = UserInputService.InputBegan:Connect(function(inp)
                local key
                if inp.UserInputType == Enum.UserInputType.Keyboard then key = inp.KeyCode.Name
                elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then key = "MouseLeft"
                elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then key = "MouseRight"
                end
                local ec
                ec = UserInputService.InputEnded:Connect(function(en)
                    if en.KeyCode.Name == key or
                        (key=="MouseLeft" and en.UserInputType==Enum.UserInputType.MouseButton1) or
                        (key=="MouseRight" and en.UserInputType==Enum.UserInputType.MouseButton2) then
                        listening = false
                        kLabel.Text = key
                        obj.Value = key
                        Library:SafeCallback(obj.ChangedCallback, en.KeyCode or en.UserInputType)
                        Library:SafeCallback(obj.Changed, en.KeyCode or en.UserInputType)
                        conn:Disconnect()
                        ec:Disconnect()
                    end
                end)
            end)
        end
    end)
    Library:AddSignal(UserInputService.InputBegan, function(i)
        if not listening and not UserInputService:GetFocusedTextBox() then
            if obj.Mode == "Toggle" then
                local n = obj.Value
                local match = (n=="MouseLeft" and i.UserInputType==Enum.UserInputType.MouseButton1) or
                              (n=="MouseRight" and i.UserInputType==Enum.UserInputType.MouseButton2) or
                              (i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode.Name==n)
                if match then
                    obj.Toggled = not obj.Toggled
                    Library:SafeCallback(obj.Callback, obj.Toggled)
                    Library:SafeCallback(obj.Clicked, obj.Toggled)
                end
            end
        end
    end)

    function obj:SetValue(_, v) obj.Value = v kLabel.Text = v end
    function obj:OnChanged(fn) obj.Changed = fn fn(obj.Value) end
    function obj:Destroy() el:Destroy() Library.Options[name] = nil end

    Library.Options[name] = obj
    return obj
end

